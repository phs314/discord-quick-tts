<?xml version="1.0" encoding="utf-8"?>
<!--
  설치 마법사의 한국어 문구.
  jpackage 기본 문구 파일(MsiInstallerStrings_en.wxl)을 이 파일로 바꿔 끼워서, 설치 화면 전체가 ko-kr 문화권으로 만들어진다.
  WiX 의 한국어 기본 문구(WixUI_ko-kr) 중 자주 보이는 화면만 아래에서 다시 쓴다.
  {\QuickTTS_Font_...} 글자 모양은 packageInstaller 가 main.wxs 에 넣는다.
-->
<WixLocalization Culture="ko-kr" Codepage="949" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <!-- jpackage 문구 (MsiInstallerStrings_en.wxl 과 같은 Id 를 모두 채운다) -->
  <String Id="MainFeatureTitle">QuickTTS</String>
  <String Id="DowngradeErrorMessage">더 새 버전의 [ProductName]이(가) 이미 설치되어 있어요. 설치를 끝낼게요.</String>
  <String Id="DisallowUpgradeErrorMessage">옛 버전의 [ProductName]이(가) 이미 설치되어 있어요. 설치를 끝낼게요.</String>

  <String Id="ShortcutPromptDlg_Title">[ProductName] 설치</String>
  <String Id="ShortcutPromptDlgTitle">{\QuickTTS_Font_Title}바로가기</String>
  <String Id="ShortcutPromptDlgBannerBitmap">WixUI_Bmp_Banner</String>
  <String Id="ShortcutPromptDlgDescription">만들 바로가기를 골라 주세요.</String>
  <String Id="ShortcutPromptDlgDesktopShortcutControlLabel">바탕화면에 바로가기 만들기</String>
  <String Id="ShortcutPromptDlgStartMenuShortcutControlLabel">시작 메뉴에 바로가기 만들기</String>

  <String Id="InstallDirNotEmptyDlg_Title">[ProductName] 설치</String>
  <String Id="InstallDirNotEmptyDlgInstallDirExistMessage">[INSTALLDIR] 폴더에 이미 파일이 있어요. 이 폴더에 그대로 설치할까요?</String>

  <String Id="ContextMenuCommandLabel">[ProductName](으)로 열기</String>

  <String Id="OsConditionMessage">이 Windows 버전에서는 [ProductName] [ProductVersion]을(를) 쓸 수 없어요.</String>

  <!-- WiX 한국어 기본 문구 중 다시 쓰는 것 -->
  <String Id="WelcomeDlgTitle">{\QuickTTS_Font_Bigger}QuickTTS 설치를 시작할게요</String>
  <String Id="WelcomeDlgDescription">단축키를 누르고 문장을 치면 디스코드 음성 채널에서 읽어 주는 QuickTTS를 이 PC에 설치해요. 계속하려면 "다음"을 누르세요.</String>

  <String Id="InstallDirDlgTitle">{\QuickTTS_Font_Title}설치할 폴더</String>
  <String Id="InstallDirDlgDescription">이대로 설치하려면 "다음"을, 다른 폴더를 고르려면 "변경"을 누르세요.</String>
  <String Id="InstallDirDlgFolderLabel">[ProductName]을(를) 설치할 폴더:</String>

  <String Id="VerifyReadyDlgInstallTitle">{\QuickTTS_Font_Title}설치할 준비가 됐어요</String>
  <String Id="VerifyReadyDlgInstallText">"설치"를 누르면 설치를 시작해요. 고른 내용을 바꾸려면 "뒤로"를 누르세요.</String>

  <String Id="ProgressDlgTitleInstalling">{\QuickTTS_Font_Title}QuickTTS 설치 중</String>
  <String Id="ProgressDlgTextInstalling">설치하는 동안 잠시 기다려 주세요.</String>

  <String Id="ExitDialogTitle">{\QuickTTS_Font_Bigger}설치를 마쳤어요</String>
  <String Id="ExitDialogDescription">QuickTTS를 켠 뒤 디스코드에서 /연결로 받은 코드를 넣으면 바로 쓸 수 있어요. 창을 닫으려면 "마침"을 누르세요.</String>
</WixLocalization>
