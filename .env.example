# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.

# Discord Developer Portal > 내 애플리케이션 > Bot > Reset Token 으로 받은 봇 토큰
DISCORD_TOKEN=

# 봇 서버 포트 (기본 8080)
# QUICKTTS_PORT=8080

# 등록된 기기, 목소리 설정을 저장할 DB (기본: 실행 위치의 data/ 폴더에 H2 파일, MySQL 호환 모드)
# QUICKTTS_DB_URL=jdbc:h2:file:./data/quicktts;MODE=MySQL
# MySQL 을 쓸 때 (배포 서버)
# QUICKTTS_DB_URL=jdbc:mysql://localhost:3306/quicktts?connectionTimeZone=UTC
# QUICKTTS_DB_USERNAME=quicktts
# QUICKTTS_DB_PASSWORD=

# 목소리를 고르지 않은 사람에게 쓸 목소리 (기본: edge:ko-KR-SunHiNeural)
# QUICKTTS_DEFAULT_VOICE=edge:ko-KR-SunHiNeural

# 웹 API 문서(/swagger-ui.html, /v3/api-docs)를 열지 (기본 true). 공개 서버에서 숨기려면 false
# QUICKTTS_API_DOCS_ENABLED=true
